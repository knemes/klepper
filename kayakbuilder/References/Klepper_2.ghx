                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">"""Provides a scripting component.
    Inputs:
        x: The x script variable
        y: The y script variable
    Output:
        a: The a output variable"""

__author__ = "Keaton Nemes"
__version__ = "2023.07.10"

import rhinoscriptsyntax as rs
import ghpythonlib.treehelpers as th
import scriptcontext as sc
import Rhino


DeckLen = len(DeckPoints)
GunwLen = len(GunwalePoints)

RibPoints = []
KGDistance = []

for i in range(DeckLen):
    PointLst = []
    PointLst.insert(1,DeckPoints[i])
    for j in range(GunwLen):
        if round(DeckPoints[i][0]) == round(GunwalePoints[j][0]):
            if (GunwalePoints[j][1] &lt; 0):
                PointLst.insert(0,GunwalePoints[j])
    RibPoints.append(PointLst)
    KGDistance.append([PointLst[0].DistanceTo(PointLst[1])])



RibTree = th.list_to_tree(RibPoints)
Points = RibTree

DisTree = th.list_to_tree(KGDistance)
Distance = DisTree</item>
